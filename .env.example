# ==========================================
# Splitzy Environment Configuration Example
# ==========================================

# Application
APP_NAME=Splitzy
APP_ENV=development
DEBUG=True

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/splitzy

# Security & JWT
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI / Intelligence (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
